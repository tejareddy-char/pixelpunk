---
import Base from '../layouts/Base.astro';
import Mascot from './Mascot.astro';
import { games } from '../data/games';
interface Props { game: (typeof games)[number]['id']; how: string[]; }
const { game, how } = Astro.props;
const g = games.find((x) => x.id === game)!;
---
<Base title={`${g.name}: a design game · Pixelpunk`} description={g.blurb}>
  <div class="game-wrap" style={`--c:${g.color}`} data-game={g.id}>
    <p style="margin-top:28px"><a href="/arcade/">← Arcade</a></p>
    <header class="game-head">
      <div>
        <p class="eyebrow">{g.icon} Arcade</p>
        <h1>{g.name}</h1>
      </div>
      <div class="hud" aria-live="polite">
        <Mascot size={72} class="hud-mascot" />
        <div><span class="pixel">Score</span><b id="hud-score">0</b></div>
        <div><span class="pixel" id="hud-extra-label">Round</span><b id="hud-extra">–</b></div>
        <div><span class="pixel">Best</span><b id="hud-best">0</b></div>
      </div>
    </header>

    <section class="screen" id="screen-start">
      <Mascot size={110} />
      <div>
        <p class="lead" style="margin-bottom:12px">{g.blurb}</p>
        <ul class="how">{how.map((h) => <li>{h}</li>)}</ul>
        <button class="btn primary big" id="btn-start" type="button">▶ Start game</button>
      </div>
    </section>

    <section class="screen play" id="screen-play" hidden>
      <slot />
    </section>

    <section class="screen over" id="screen-over" hidden>
      <div class="over-main">
        <p class="pixel over-title" id="over-title">Game over</p>
        <p class="final"><span class="pixel">Score</span> <b id="over-score">0</b></p>
        <p class="muted" id="over-msg"></p>
        <div class="toolbar">
          <button class="btn primary" id="btn-again" type="button">↻ Play again</button>
          <button class="btn" id="btn-share" type="button">Share score</button>
          <a class="btn" href="/arcade/">Other games</a>
        </div>
      </div>
      <div class="board">
        <p class="pixel" style="margin:0 0 10px;color:var(--c)">Leaderboard</p>
        <ol id="leaderboard"><li class="muted">Loading…</li></ol>
        <p class="muted small" id="lb-note"></p>
      </div>
    </section>
  </div>

  <style is:global>
    .game-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 16px; margin-bottom: 20px; }
    .game-head h1 { margin: 6px 0 0; font-size: clamp(1.8rem, 5vw, 3rem); color: var(--c); }
    .hud { display: flex; gap: 10px; }
    .hud { align-items: flex-end; }
    .hud .hud-mascot { margin-right: 4px; }
    .hud div { background: var(--surface); border: 2px solid var(--line); padding: 6px 14px; min-width: 84px; text-align: center; }
    .hud .pixel { display: block; font-size: .62rem; color: var(--muted); }
    .hud b { font-family: var(--font-pixel); font-weight: 400; font-size: 1.3rem; color: var(--c); }
    .hud b.bump { animation: pop .3s cubic-bezier(.3,2,.5,1); }
    .screen { background: var(--surface); border: 2px solid var(--line); box-shadow: 8px 8px 0 var(--c); padding: 28px; min-height: 380px; }
    #screen-start { display: flex; gap: 28px; align-items: center; flex-wrap: wrap; }
    #screen-start[hidden], #screen-over[hidden], #screen-play[hidden] { display: none; }
    .how { margin: 0 0 22px; padding-left: 20px; color: var(--muted); }
    .how li { margin: 4px 0; }
    .btn.big { font-size: 1.1rem; padding: 13px 26px; }
    .over { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 28px; }
    @media (max-width: 760px) { .over { grid-template-columns: 1fr; } }
    .over-title { font-size: 1.6rem; color: var(--c); margin: 0; }
    .final { font-size: 1rem; margin: 12px 0 6px; }
    .final b { font-family: var(--font-pixel); font-weight: 400; font-size: 3.4rem; color: var(--ink); display: block; line-height: 1.1; }
    .board { background: var(--bg-2); border: 2px solid var(--line); padding: 16px 18px; }
    .board ol { margin: 0; padding-left: 26px; }
    .board li { padding: 3px 0; font-variant-numeric: tabular-nums; }
    .board li.me { color: var(--lime); font-weight: 700; }
    .small { font-size: .85rem; }
    .feedback { min-height: 1.6em; font-weight: 700; margin: 12px 0 0; }
    .feedback.good { color: var(--good); } .feedback.bad { color: var(--bad); }
    .timer { height: 8px; background: var(--bg-2); border: 2px solid var(--line); margin-bottom: 18px; }
    .timer > div { height: 100%; background: var(--c); width: 100%; transition: width .1s linear; }
    .timer.low > div { background: var(--bad); }
  </style>
</Base>
