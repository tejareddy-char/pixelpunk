---
import Base from '../layouts/Base.astro';
import { getArticles, sources } from '../lib/feeds';
const { articles } = await getArticles();
const usedSources = sources.filter((s) => articles.some((a) => a.source === s.name));
const fmt = (iso: string) => iso ? new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) : '';
const updated = new Date().toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title="Latest UX & UI design articles · Designkit" description="The latest articles from Nielsen Norman Group, Smashing Magazine, UX Collective and other top design publications, in one place.">
  <h1>Articles</h1>
  <p class="lead">The newest UX and UI articles from {usedSources.length} trusted design publications, in one feed. Last updated {updated}.</p>

  <input class="search" id="q" type="search" placeholder="Search articles, e.g. accessibility, design systems, AI" aria-label="Search articles" />
  <div class="chips" id="chips" role="group" aria-label="Filter by publication">
    <button class="chip" data-src="all" aria-pressed="true">All</button>
    {usedSources.map((s) => <button class="chip" data-src={s.name} aria-pressed="false">{s.name}</button>)}
  </div>

  {articles.length === 0 && <p class="muted">Articles couldn't be loaded on the last update. They'll be back after the next deploy.</p>}

  <div class="article-list">
    {articles.map((a) => (
      <a class="card article" href={a.link} target="_blank" rel="noopener" data-src={a.source}
         data-text={`${a.title} ${a.summary} ${a.source}`.toLowerCase()}>
        <div class="meta"><span class="eyebrow">{a.source}</span>{a.date && <span class="muted" style="font-size:.8rem">{fmt(a.date)}</span>}</div>
        <h3>{a.title}</h3>
        {a.summary && <p>{a.summary}</p>}
      </a>
    ))}
  </div>
  <p class="empty" id="empty">No articles match.</p>

  <style>
    .article-list { display: grid; gap: 12px; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); }
    @media (max-width: 400px) { .article-list { grid-template-columns: 1fr; } }
  </style>

  <script>
    const q = document.getElementById('q') as HTMLInputElement;
    const cards = [...document.querySelectorAll<HTMLElement>('.article')];
    const chips = [...document.querySelectorAll<HTMLButtonElement>('#chips .chip')];
    const empty = document.getElementById('empty')!;
    let src = 'all';
    const apply = () => {
      const term = q.value.trim().toLowerCase();
      let shown = 0;
      cards.forEach((c) => {
        const ok = (src === 'all' || c.dataset.src === src) && (!term || (c.dataset.text ?? '').includes(term));
        c.style.display = ok ? '' : 'none'; if (ok) shown++;
      });
      chips.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.src === src)));
      empty.style.display = shown || !cards.length ? 'none' : 'block';
    };
    q.addEventListener('input', apply);
    chips.forEach((b) => b.addEventListener('click', () => { src = b.dataset.src ?? 'all'; apply(); }));
  </script>
</Base>
