---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
export async function getStaticPaths() {
  const kits = await getCollection('kits');
  return kits.map((kit) => ({ params: { id: kit.id }, props: { kit } }));
}
const { kit } = Astro.props;
const { Content } = await render(kit);
const markdown = `# ${kit.data.title}\n\n${kit.data.description}\n\n${(kit.body ?? '').trim()}\n`;
---
<Base title={`${kit.data.title} · Pixelpunk`} description={kit.data.description}>
  <div class="narrow">
    <p class="no-print" style="margin-top:32px"><a href="/kits/">← Research kits</a></p>
    <div style="display:flex;gap:8px;align-items:center;margin-top:24px">
      <span class="eyebrow">{kit.data.stage}</span><span class="tag">{kit.data.time}</span>
    </div>
    <h1 style="margin-top:10px;font-size:clamp(1.8rem,5vw,3rem)">{kit.data.icon} {kit.data.title}</h1>
    <p class="lead">{kit.data.description}</p>
    <div class="toolbar no-print">
      <button class="btn primary" id="copy" type="button">Copy as Markdown</button>
      <button class="btn" id="download" type="button">Download .md</button>
      <button class="btn" id="print" type="button">Print / PDF</button>
      <button class="btn" id="save" type="button" aria-pressed="false">♥ Save</button>
    </div>
    <div class="progress no-print" id="progress" hidden>
      <div class="bar"><div class="bar-fill" id="bar-fill"></div></div>
      <span class="pixel" id="bar-label">0%</span>
    </div>
    <article class="prose" id="kit" data-id={kit.id} data-title={kit.data.title}><Content /></article>
  </div>
  <template id="md">{markdown}</template>

  <style is:global>
    .progress { display: flex; align-items: center; gap: 12px; margin: 18px 0 6px; position: sticky; top: 70px; z-index: 5; background: var(--bg); padding: 8px 0; }
    .progress .bar { flex: 1; height: 14px; border: 2px solid var(--line); background: var(--bg-2); }
    .progress .bar-fill { height: 100%; width: 0; background: repeating-linear-gradient(90deg, var(--lime) 0 10px, #a5d92f 10px 12px); transition: width .4s cubic-bezier(.3,1.4,.5,1); }
    .progress .pixel { font-size: .8rem; color: var(--lime); min-width: 48px; text-align: right; }
    @media print {
      .site-header, .site-footer, .no-print, .toast-host { display: none !important; }
      body { background: #fff; color: #000; } body::after { display: none; }
      .prose h2, .prose h3, .prose code { color: #000; }
    }
  </style>

  <script>
    import { loadChecks, saveChecks, onUser, toggleFav, isFavLocal } from '../../lib/supabase';
    import { toast, confetti } from '../../lib/ui';
    const md = (document.getElementById('md') as HTMLTemplateElement).content.textContent ?? '';
    const article = document.getElementById('kit')!;
    const id = article.dataset.id!, title = article.dataset.title!;

    const copy = document.getElementById('copy')!;
    copy.addEventListener('click', async () => {
      await navigator.clipboard.writeText(md);
      copy.textContent = '✓ Copied'; setTimeout(() => (copy.textContent = 'Copy as Markdown'), 1500);
    });
    document.getElementById('download')!.addEventListener('click', () => {
      const a = document.createElement('a');
      a.href = URL.createObjectURL(new Blob([md], { type: 'text/markdown' }));
      a.download = `${id}.md`; a.click();
      setTimeout(() => URL.revokeObjectURL(a.href), 1000);
    });
    document.getElementById('print')!.addEventListener('click', () => window.print());

    const save = document.getElementById('save')!;
    const paintSave = (on: boolean) => { save.setAttribute('aria-pressed', String(on)); save.textContent = on ? '♥ Saved' : '♥ Save'; };
    paintSave(isFavLocal('kit', id));
    save.addEventListener('click', async () => {
      const on = await toggleFav({ kind: 'kit', id, title, href: location.pathname });
      paintSave(on); toast(on ? '♥ Saved to your stash' : 'Removed from your stash');
    });

    // Checklists: clickable, saved (browser or account), with a progress bar.
    const boxes = [...article.querySelectorAll<HTMLInputElement>('input[type="checkbox"]')];
    const progress = document.getElementById('progress')!, fill = document.getElementById('bar-fill')!, label = document.getElementById('bar-label')!;
    let celebrated = false;
    const paint = () => {
      const done = boxes.filter((b) => b.checked).length, pct = Math.round((done / boxes.length) * 100);
      fill.style.width = `${pct}%`; label.textContent = `${pct}%`;
      if (pct === 100 && !celebrated) { celebrated = true; confetti(); toast('🏆 Kit complete! Nice work.'); }
      if (pct < 100) celebrated = false;
    };
    if (boxes.length) {
      progress.hidden = false;
      boxes.forEach((b) => {
        b.disabled = false;
        b.addEventListener('change', () => { paint(); void saveChecks(id, boxes.map((x) => x.checked)); });
      });
      const load = async () => { const saved = await loadChecks(id); boxes.forEach((b, i) => (b.checked = !!saved[i])); celebrated = boxes.every((b) => b.checked); paint(); };
      onUser(() => void load());
    }
  </script>
</Base>
